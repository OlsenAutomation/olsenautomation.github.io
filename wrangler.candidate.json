{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olsen-automation-v2-preview",
  "main": "src/candidate-worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist-candidate",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "send_metrics": false,
  "vars": {
    "VISIT_NOTIFICATIONS": "disabled",
    "RELEASE_QA_EXPIRES": "0"
  }
}
