{
  "name": "olsen-automation-site-v2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 tools/build.py",
    "media": "python3 tools/media.py",
    "media:projects": "python3 tools/project_media.py",
    "validate": "python3 tools/validate.py",
    "preview": "node tools/serve.mjs",
    "test": "node tools/checks.mjs",
    "check": "npm run build && npm run validate && npm test && node tools/check-media-worker.mjs && node tools/check-buffered-journey.mjs && node tools/check-scroll-journey.mjs && node tools/check-intake-receiver.mjs",
    "preview:upload": "node tools/upload-preview.mjs",
    "media:videos": "python3 tools/project_videos.py",
    "release:review": "npm run check && python3 tools/release_review.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  }
}
