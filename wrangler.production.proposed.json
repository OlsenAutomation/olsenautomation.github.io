{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olsen-automation-v2",
  "main": "src/production-worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-production",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "send_metrics": false,
  "vars": {
    "VISIT_NOTIFICATIONS": "enabled"
  },
  "routes": [
    {
      "pattern": "olsenautomation.com",
      "custom_domain": true
    },
    {
      "pattern": "www.olsenautomation.com",
      "custom_domain": true
    }
  ]
}
